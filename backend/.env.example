PORT=5000
MONGODB_URI=mongodb://localhost:27017/one-call-service
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=1d
NODE_ENV=development
ADMIN_EMAIL=admin@example.com
# Use a bcrypt hash generated locally; never put the plaintext password here.
ADMIN_PASSWORD_HASH=

# Resend API configuration for admin password reset
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Payment (Razorpay - when integrated)
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
